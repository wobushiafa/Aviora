<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Aviora.Controls</PackageId>
    <Title>Aviora Controls</Title>
    <Description>A modern, open-source Avalonia control library.</Description>
    <Authors>Aviora contributors</Authors>
    <PackageTags>avalonia;ui;controls;desktop;cross-platform</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>aviora.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <VersionPrefix>0.3.2</VersionPrefix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aviora.Core\Aviora.Core.csproj" />
    <ProjectReference Include="..\Aviora.Presentation.Abstractions\Aviora.Presentation.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\samples\Aviora.Demo\Assets\aviora.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
