<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Aviora.Core</PackageId>
    <Title>Aviora Core</Title>
    <Description>Framework-independent data contracts and algorithms for Aviora controls.</Description>
    <Authors>Aviora contributors</Authors>
    <PackageTags>ui;controls;core;cross-platform</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>aviora.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <VersionPrefix>0.2.0</VersionPrefix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\samples\Aviora.Demo\Assets\aviora.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
