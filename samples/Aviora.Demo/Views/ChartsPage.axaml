<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="https://github.com/wobushiafa/Aviora"
             xmlns:vm="using:Aviora.Demo.ViewModels"
             x:Class="Aviora.Demo.Views.ChartsPage"
             x:DataType="vm:ChartsPageViewModel"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="640">
    <UserControl.Resources>
        <DataTemplate x:Key="TrendToolTipTemplate" x:DataType="controls:IChartDataPoint">
            <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                <TextBlock Opacity="0.72" Text="{Binding Value, StringFormat='Value: {0:F1}'}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Charts" />
            <TextBlock Opacity="0.65"
                       Text="Data, axes, thresholds, interaction, animation, and tooltips"
                       TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <CheckBox Margin="0,0,16,0" Content="Grid" IsChecked="{Binding ShowGridLines}" />
            <CheckBox Margin="0,0,16,0" Content="Threshold labels" IsChecked="{Binding ShowThresholdLabels}" />
            <CheckBox Margin="0,0,16,0" Content="Tooltips" IsChecked="{Binding IsToolTipEnabled}" />
            <CheckBox Content="Animation" IsChecked="{Binding IsAnimationEnabled}" />
        </WrapPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Columns">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,18,4,24" Spacing="18">
                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Rich data, thresholds, and selection" />
                                        <TextBlock Opacity="0.65" Text="ItemsSource, per-item brushes, full-height tracks, commands, and two-way selection" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Opacity="0.65"
                                               Text="{Binding InteractionStatus}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <controls:ColumnChart Height="300"
                                                      ItemsSource="{Binding MonthlySales}"
                                                      Thresholds="{Binding MonthlySalesThresholds}"
                                                      AutoRange="True"
                                                      AutoRangePaddingRatio="0.12"
                                                      GridLineCount="5"
                                                      ShowGridLines="{Binding ShowGridLines}"
                                                      ShowThresholds="True"
                                                      ShowThresholdLabels="{Binding ShowThresholdLabels}"
                                                      ThresholdLabelFontSize="10"
                                                      IsAnimationEnabled="{Binding IsAnimationEnabled}"
                                                      AnimationDuration="0:0:0.45"
                                                      AnimationItemLimit="200"
                                                      UpdateThrottleInterval="0:0:0.25"
                                                      IsToolTipEnabled="{Binding IsToolTipEnabled}"
                                                      ColumnBackgroundBrush="#E2E8F0"
                                                      HoverSlotBrush="#100F766E"
                                                      BarWidthRatio="0.55"
                                                      BarCornerRadius="6,6,0,0"
                                                      ShowDataLabels="True"
                                                      DataLabelFontSize="10"
                                                      XAxisTextBrush="#64748B"
                                                      YAxisTextBrush="#475569"
                                                      XAxisFontSize="10"
                                                      YAxisFontSize="10"
                                                      GridLineBrush="#CBD5E1"
                                                      DefaultBrush="#0F766E"
                                                      SelectedIndex="{Binding SelectedColumnIndex}"
                                                      SelectedItem="{Binding SelectedColumnItem}"
                                                      ItemClickCommand="{Binding ChartItemClickedCommand}"
                                                      SelectedBarBrush="#0D9488"
                                                      SelectionOverlayBrush="#35FFFFFF"
                                                      SelectionStrokeBrush="#0F172A"
                                                      SelectionStrokeThickness="2" />
                            </StackPanel>
                        </controls:AvioraCard>

                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Simple values and reversed severity" />
                                <TextBlock Opacity="0.65" Text="Values with external labels; lower values cross progressively more severe thresholds" />
                                <controls:ColumnChart Height="280"
                                                      Values="{Binding WeeklyValues}"
                                                      XAxisLabelsSource="{Binding WeeklyLabels}"
                                                      XAxisLabelMode="All"
                                                      Thresholds="{Binding WeeklyScoreThresholds}"
                                                      ThresholdDirection="LowerIsMoreSevere"
                                                      AutoRange="True"
                                                      GridLineCount="5"
                                                      ShowGridLines="{Binding ShowGridLines}"
                                                      ShowThresholds="True"
                                                      ShowThresholdLabels="{Binding ShowThresholdLabels}"
                                                      IsAnimationEnabled="False"
                                                      IsToolTipEnabled="{Binding IsToolTipEnabled}"
                                                      UpdateThrottleInterval="0"
                                                      ColumnBackgroundBrush="#DCFCE7"
                                                      XAxisTextBrush="#64748B"
                                                      YAxisTextBrush="#475569"
                                                      GridLineBrush="#CBD5E1"
                                                      DefaultBrush="#15803D" />
                            </StackPanel>
                        </controls:AvioraCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lines">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,18,4,24" Spacing="18">
                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Animated smooth trend" />
                                        <TextBlock Opacity="0.65"
                                                   Text="Smooth interpolation, area fill, point styling, selected point, and custom Tooltip template"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <Button Command="{Binding UpdateTrendCommand}"
                                                Content="Update data" />
                                        <Button Command="{Binding AddRandomTrendPointCommand}"
                                                Content="Add random point" />
                                    </StackPanel>
                                </Grid>
                                <controls:LineChart Height="310"
                                                    ItemsSource="{Binding AnimatedTrend}"
                                                    Thresholds="{Binding MonthlySalesThresholds}"
                                                    AutoRange="True"
                                                    GridLineCount="5"
                                                    ShowGridLines="{Binding ShowGridLines}"
                                                    ShowThresholds="True"
                                                    ShowThresholdLabels="{Binding ShowThresholdLabels}"
                                                    IsAnimationEnabled="{Binding IsAnimationEnabled}"
                                                    AnimationDuration="0:0:0.55"
                                                    UpdateThrottleInterval="0"
                                                    InterpolationMode="Smooth"
                                                    LineBrush="#2563EB"
                                                    LineThickness="3"
                                                    AreaFillBrush="#202563EB"
                                                    ShowPoints="True"
                                                    PointBrush="#1D4ED8"
                                                    PointRadius="4"
                                                    PointStrokeBrush="White"
                                                    PointStrokeThickness="2"
                                                    SelectedIndex="{Binding SelectedLineIndex}"
                                                    SelectedPointBrush="#DC2626"
                                                    SelectedPointRadius="7"
                                                    ItemClickCommand="{Binding ChartItemClickedCommand}"
                                                    IsToolTipEnabled="{Binding IsToolTipEnabled}"
                                                    ToolTipTemplate="{StaticResource TrendToolTipTemplate}"
                                                    ToolTipBackground="#F9FAFB"
                                                    ToolTipTextBrush="#111827"
                                                    ToolTipFontSize="12"
                                                    ToolTipPadding="10,8"
                                                    ToolTipCornerRadius="6"
                                                    ToolTipBorderBrush="#CBD5E1"
                                                    ToolTipBorderThickness="1"
                                                    ToolTipBoxShadow="0 4 12 0 #33000000"
                                                    ToolTipHorizontalOffset="12"
                                                    ToolTipVerticalOffset="10"
                                                    XAxisTextBrush="#64748B"
                                                    YAxisTextBrush="#475569"
                                                    GridLineBrush="#CBD5E1" />
                            </StackPanel>
                        </controls:AvioraCard>

                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Multi-series comparison" />
                                <TextBlock Opacity="0.65"
                                           Text="Built-in interactive legend (click to toggle), dashed series, vertical crosshair, and shared tooltip"
                                           TextWrapping="Wrap" />
                                <controls:LineChart Height="290"
                                                    Series="{Binding ComparisonSeries}"
                                                    XAxisLabelsSource="{Binding ComparisonLabels}"
                                                    XAxisLabelMode="All"
                                                    AutoRange="False"
                                                    MinValue="0"
                                                    MaxValue="100"
                                                    YAxisLabelsSource="{Binding PerformanceAxisLabels}"
                                                    InterpolationMode="MonotoneSmooth"
                                                    LineThickness="2.5"
                                                    ShowPoints="True"
                                                    PointRadius="4"
                                                    PointStrokeBrush="White"
                                                    PointStrokeThickness="1.5"
                                                    ShowLegend="True"
                                                    IsLegendInteractive="True"
                                                    CrosshairMode="Vertical"
                                                    ToolTipMode="SharedCategory"
                                                    HoverPointRadius="6"
                                                    HoverHaloBrush="#282563EB"
                                                    ShowGridLines="{Binding ShowGridLines}"
                                                    IsAnimationEnabled="{Binding IsAnimationEnabled}"
                                                    AnimationDuration="0:0:0.55"
                                                    IsToolTipEnabled="{Binding IsToolTipEnabled}"
                                                    UpdateThrottleInterval="0" />
                            </StackPanel>
                        </controls:AvioraCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Axes &amp; states">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,18,4,24" Spacing="18">
                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Fixed range, negative values, and label density" />
                                <TextBlock Opacity="0.65" Text="Manual range, zero baseline, custom Y-axis formatting, and interval category labels" />
                                <controls:ColumnChart Height="290"
                                                      Values="{Binding VarianceValues}"
                                                      XAxisLabelsSource="{Binding VarianceLabels}"
                                                      AutoRange="False"
                                                      MinValue="-50"
                                                      MaxValue="50"
                                                      GridLineCount="6"
                                                      XAxisLabelMode="Interval"
                                                      XAxisLabelInterval="2"
                                                      YAxisLabelFormatter="{Binding VarianceAxisFormatter}"
                                                      YAxisWidth="52"
                                                      XAxisHeight="28"
                                                      ShowGridLines="{Binding ShowGridLines}"
                                                      GridLineBrush="#CBD5E1"
                                                      DefaultBrush="#0891B2"
                                                      ColumnBackgroundBrush="#ECFEFF"
                                                      IsAnimationEnabled="{Binding IsAnimationEnabled}"
                                                      IsToolTipEnabled="{Binding IsToolTipEnabled}"
                                                      UpdateThrottleInterval="0" />
                            </StackPanel>
                        </controls:AvioraCard>

                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Y-axis glyph alignment" />
                                <TextBlock Opacity="0.65"
                                           Text="The visible center of every label should sit on its grid line at 10, 16, and 24 px font sizes"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="10 px" />
                                        <controls:LineChart Height="230"
                                                            Values="{Binding WeeklyValues}"
                                                            AutoRange="False"
                                                            MinValue="0"
                                                            MaxValue="60"
                                                            GridLineCount="7"
                                                            YAxisFontSize="10"
                                                            YAxisWidth="48"
                                                            ShowXAxis="False"
                                                            ShowYAxis="True"
                                                            ShowGridLines="True"
                                                            ShowPoints="False"
                                                            IsToolTipEnabled="False"
                                                            IsAnimationEnabled="False"
                                                            LineBrush="#0F766E"
                                                            LineThickness="2"
                                                            GridLineBrush="#64748B"
                                                            YAxisTextBrush="#0F172A" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="16 px" />
                                        <controls:LineChart Height="230"
                                                            Values="{Binding WeeklyValues}"
                                                            AutoRange="False"
                                                            MinValue="0"
                                                            MaxValue="60"
                                                            GridLineCount="7"
                                                            YAxisFontSize="16"
                                                            YAxisWidth="58"
                                                            ShowXAxis="False"
                                                            ShowYAxis="True"
                                                            ShowGridLines="True"
                                                            ShowPoints="False"
                                                            IsToolTipEnabled="False"
                                                            IsAnimationEnabled="False"
                                                            LineBrush="#2563EB"
                                                            LineThickness="2"
                                                            GridLineBrush="#64748B"
                                                            YAxisTextBrush="#0F172A" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="24 px" />
                                        <controls:LineChart Height="230"
                                                            Values="{Binding WeeklyValues}"
                                                            AutoRange="False"
                                                            MinValue="0"
                                                            MaxValue="60"
                                                            GridLineCount="7"
                                                            YAxisFontSize="24"
                                                            YAxisWidth="72"
                                                            ShowXAxis="False"
                                                            ShowYAxis="True"
                                                            ShowGridLines="True"
                                                            ShowPoints="False"
                                                            IsToolTipEnabled="False"
                                                            IsAnimationEnabled="False"
                                                            LineBrush="#B45309"
                                                            LineThickness="2"
                                                            GridLineBrush="#64748B"
                                                            YAxisTextBrush="#0F172A" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </controls:AvioraCard>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                            <controls:AvioraCard HorizontalAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Empty state" />
                                    <TextBlock Opacity="0.65" Text="Custom message, text color, and size" />
                                    <controls:ColumnChart Height="210"
                                                          Values="{Binding EmptyValues}"
                                                          AutoRange="True"
                                                          ShowEmptyText="True"
                                                          EmptyText="Waiting for telemetry"
                                                          EmptyTextBrush="#64748B"
                                                          EmptyTextFontSize="14"
                                                          ShowGridLines="False" />
                                </StackPanel>
                            </controls:AvioraCard>

                            <controls:AvioraCard Grid.Column="1" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Minimal plot" />
                                    <TextBlock Opacity="0.65" Text="Axes, labels, grid, points, and Tooltip can all be disabled" />
                                    <controls:LineChart Height="210"
                                                        Values="{Binding WeeklyValues}"
                                                        MinValue="0"
                                                        MaxValue="60"
                                                        ShowXAxis="False"
                                                        ShowYAxis="False"
                                                        ShowGridLines="False"
                                                        ShowPoints="False"
                                                        IsToolTipEnabled="False"
                                                        IsAnimationEnabled="False"
                                                        LineBrush="#E11D48"
                                                        LineThickness="3" />
                                </StackPanel>
                            </controls:AvioraCard>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Customization &amp; Perf">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,18,4,24" Spacing="18">
                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Multi-series columns (Grouped / Stacked / 100%)" />
                                        <TextBlock Opacity="0.65" Text="Click legend items to toggle series visibility; switch layout modes dynamically." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding ColumnLayoutModes}"
                                              SelectedItem="{Binding SelectedColumnLayoutMode}" />
                                </Grid>

                                <controls:ColumnChart Height="270"
                                                      Series="{Binding MultiColumnSeries}"
                                                      SeriesLayoutMode="{Binding SelectedColumnLayoutMode}"
                                                      XAxisLabelsSource="{Binding QuarterLabels}"
                                                      XAxisLabelMode="All"
                                                      AutoRange="True"
                                                      BarWidthRatio="0.68"
                                                      BarCornerRadius="5,5,0,0"
                                                      ShowLegend="True"
                                                      IsLegendInteractive="True"
                                                      CrosshairMode="Vertical"
                                                      ToolTipMode="SharedCategory"
                                                      HoverSlotBrush="#100F766E"
                                                      ShowAxisLines="True"
                                                      ShowGridLines="{Binding ShowGridLines}"
                                                      IsAnimationEnabled="{Binding IsAnimationEnabled}"
                                                      IsToolTipEnabled="{Binding IsToolTipEnabled}"
                                                      UpdateThrottleInterval="0" />
                            </StackPanel>
                        </controls:AvioraCard>

                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Interpolation &amp; overshoot control" />
                                        <TextBlock Opacity="0.65" Text="Compare MonotoneSmooth (zero overshoot) against Catmull-Rom Smooth and Step modes." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding InterpolationModes}"
                                              SelectedItem="{Binding SelectedLineInterpolation}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <TextBlock VerticalAlignment="Center" Text="Smooth tension" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1.8" Value="{Binding LineTension}" />
                                    <TextBlock Grid.Column="2" MinWidth="36" VerticalAlignment="Center"
                                               Text="{Binding LineTension, StringFormat={}{0:0.00}}" />
                                </Grid>

                                <controls:LineChart Height="240"
                                                    Values="{Binding StepAndOvershootValues}"
                                                    InterpolationMode="{Binding SelectedLineInterpolation}"
                                                    LineTension="{Binding LineTension}"
                                                    AutoRange="False"
                                                    MinValue="-15"
                                                    MaxValue="115"
                                                    ShowZeroBaseline="True"
                                                    ShowAxisLines="True"
                                                    PointShape="Diamond"
                                                    PointRadius="4.5"
                                                    HoverPointRadius="7"
                                                    HoverHaloBrush="#302563EB"
                                                    LineBrush="#2563EB"
                                                    AreaFillBrush="#1C2563EB"
                                                    CrosshairMode="Both"
                                                    ShowGridLines="{Binding ShowGridLines}"
                                                    IsAnimationEnabled="{Binding IsAnimationEnabled}"
                                                    IsToolTipEnabled="{Binding IsToolTipEnabled}"
                                                    UpdateThrottleInterval="0" />
                            </StackPanel>
                        </controls:AvioraCard>

                        <controls:AvioraCard HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="5,000-point telemetry (Downsampling + Zoom &amp; Pan)" />
                                        <TextBlock Opacity="0.65" Text="Mouse wheel to zoom at cursor, drag to pan, double-click plot or click Reset zoom." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding DownsampleModes}"
                                              SelectedItem="{Binding SelectedDownsampleMode}" />
                                    <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Command="{Binding RegenerateLargeDatasetCommand}"
                                            Content="New 5,000 pts" />
                                    <Button Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Command="{Binding ResetLargeChartZoomCommand}"
                                            Content="Reset zoom" />
                                </Grid>

                                <controls:LineChart Height="260"
                                                    Values="{Binding LargeDataset}"
                                                    DownsampleMode="{Binding SelectedDownsampleMode}"
                                                    DownsampleThreshold="500"
                                                    AutoRange="True"
                                                    AutoRangeIncludeZero="False"
                                                    IsZoomEnabled="True"
                                                    IsPanEnabled="True"
                                                    ZoomStartRatio="{Binding ZoomStartRatio, Mode=TwoWay}"
                                                    ZoomEndRatio="{Binding ZoomEndRatio, Mode=TwoWay}"
                                                    CrosshairMode="Both"
                                                    ShowPoints="False"
                                                    LineBrush="#0F766E"
                                                    LineThickness="1.75"
                                                    AreaFillBrush="#1A0F766E"
                                                    ShowGridLines="{Binding ShowGridLines}"
                                                    IsAnimationEnabled="False"
                                                    IsToolTipEnabled="{Binding IsToolTipEnabled}"
                                                    UpdateThrottleInterval="0" />
                            </StackPanel>
                        </controls:AvioraCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
