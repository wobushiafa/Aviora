<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aviora.Demo.ViewModels"
        xmlns:aviora="https://github.com/wobushiafa/Aviora"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Aviora.Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="640"
        Icon="/Assets/aviora.ico"
        Width="1040"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        Title="Aviora Controls">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:DrawerDemoViewModel" x:DataType="vm:DrawerDemoViewModel">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="24">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Profile settings" />
                    <TextBlock Opacity="0.65" Text="Presented by IDrawerService" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Display name" />
                        <TextBox Text="{Binding DisplayName}" />
                    </StackPanel>
                    <CheckBox Content="Enable notifications" IsChecked="{Binding NotificationsEnabled}" />
                </StackPanel>
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Right"
                            IsVisible="{Binding ShowFooterActions}"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Command="{Binding CancelCommand}" Content="Cancel" />
                    <Button Command="{Binding SaveCommand}" Content="Save" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:ProfileDialogViewModel" x:DataType="vm:ProfileDialogViewModel">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="20">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Edit profile" />
                    <TextBlock Opacity="0.65" Text="Update the account details below." />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Display name" />
                        <TextBox Text="{Binding DisplayName}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Email" />
                        <TextBox Text="{Binding Email}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Command="{Binding CancelCommand}" Content="Cancel" />
                    <Button Command="{Binding SaveCommand}" Content="Save" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:ConfirmationDialogViewModel" x:DataType="vm:ConfirmationDialogViewModel">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18" Width="360">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Confirm action" />
                <TextBlock Grid.Row="1"
                           Text="Continue with this operation?"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Command="{Binding CancelCommand}" Content="Cancel" />
                    <Button Command="{Binding ConfirmCommand}" Content="Confirm" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <aviora:Dialog x:Name="DialogHost">
    <aviora:Drawer x:Name="DrawerHost"
                     Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                     BorderThickness="1,0,0,0"
                     Padding="24">
    <Grid ColumnDefinitions="216,*">
        <Border Padding="20,24"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Aviora" />
                    <TextBlock FontSize="12" Opacity="0.62" Text="Control Gallery" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Margin="4,32,0,8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Opacity="0.55"
                           Text="CONTROLS" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DemoPageViewModel">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3"
                           Margin="4,16,0,0"
                           FontSize="11"
                           Opacity="0.48"
                           Text="Aviora.Controls" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,0">
            <ContentControl Content="{Binding SelectedPage}" />
        </Grid>
    </Grid>
    </aviora:Drawer>
    </aviora:Dialog>
</Window>
