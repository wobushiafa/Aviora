<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="https://github.com/wobushiafa/Aviora"
             xmlns:vm="using:Aviora.Demo.ViewModels"
             x:Class="Aviora.Demo.Views.DialGaugePage"
             x:DataType="vm:DialGaugePageViewModel"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="560">
    <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Dial gauge" />
            <TextBlock Opacity="0.65" Text="Radial values, ticks, labels, and range colors" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,24"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="18"
                  RowSpacing="18">
                <controls:AvioraCard HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Live value" />
                            <TextBlock Grid.Column="1"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding Value, StringFormat={}{0:F0}}" />
                        </Grid>

                        <controls:DialGauge Grid.Row="1"
                                            Width="300"
                                            Height="210"
                                            HorizontalAlignment="Center"
                                            Value="{Binding Value}"
                                            ShowTicks="{Binding ShowTicks}"
                                            TickCount="{Binding TickCount}"
                                            TickColorMode="{Binding TickColorMode}"
                                            ShowTickLabels="{Binding ShowTickLabels}"
                                            TickLabelInterval="{Binding TickLabelInterval}"
                                            LowRangeBrush="#10B981"
                                            MediumRangeBrush="#F59E0B"
                                            HighRangeBrush="#EF4444"
                                            NeedleBrush="#2563EB"
                                            PivotBrush="#1E40AF" />

                        <StackPanel Grid.Row="2" Spacing="12">
                            <Slider Minimum="0" Maximum="100" Value="{Binding Value}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <CheckBox Content="Ticks" IsChecked="{Binding ShowTicks}" />
                                <CheckBox Grid.Column="1"
                                          Content="Labels"
                                          IsChecked="{Binding ShowTickLabels}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12" Opacity="0.65" Text="Tick colors" />
                                    <ComboBox ItemsSource="{Binding TickColorModes}"
                                              SelectedItem="{Binding TickColorMode}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock FontSize="12" Opacity="0.65" Text="Tick count" />
                                    <NumericUpDown Minimum="1"
                                                   Maximum="100"
                                                   Value="{Binding TickCount}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="12" Opacity="0.65" Text="Label interval" />
                                <NumericUpDown Minimum="1"
                                               Maximum="20"
                                               Value="{Binding TickLabelInterval}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:AvioraCard>

                <controls:AvioraCard Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel Spacing="16">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Appearance" />

                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <controls:DialGauge Width="240"
                                                Height="170"
                                                Value="72"
                                                TickBrush="#0891B2"
                                                TickLabelBrush="#0E7490"
                                                NeedleBrush="#F97316"
                                                PivotBrush="#C2410C" />
                            <TextBlock HorizontalAlignment="Center" Text="Ocean + orange needle" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <controls:DialGauge Width="240"
                                                Height="170"
                                                Value="84"
                                                TickColorMode="Range"
                                                LowRangeBrush="#22C55E"
                                                MediumRangeBrush="#FBBF24"
                                                HighRangeBrush="#F43F5E"
                                                NeedleBrush="#3B82F6"
                                                PivotBrush="#4338CA" />
                            <TextBlock HorizontalAlignment="Center" Text="Range + blue needle" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <controls:DialGauge Width="240"
                                                Height="170"
                                                Value="52"
                                                TickBrush="#7C3AED"
                                                TickLabelBrush="#6D28D9"
                                                NeedleBrush="#DB2777"
                                                PivotBrush="#9D174D" />
                            <TextBlock HorizontalAlignment="Center" Text="Custom palette" />
                        </StackPanel>
                    </StackPanel>
                </controls:AvioraCard>

                <controls:AvioraCard Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="24"
                          RowSpacing="12">
                        <TextBlock Grid.ColumnSpan="2"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Transitions" />

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="6">
                            <controls:DialGauge Width="280"
                                                Height="190"
                                                Value="{Binding TransitionValue}"
                                                TickBrush="#06B6D4"
                                                TickLabelBrush="#0E7490"
                                                NeedleBrush="{Binding TransitionNeedleBrush}"
                                                PivotBrush="#164E63" />
                            <TextBlock HorizontalAlignment="Center" Text="Immediate (default)" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Spacing="6">
                            <controls:DialGauge Width="280"
                                                Height="190"
                                                Value="{Binding TransitionValue}"
                                                TickColorMode="Range"
                                                LowRangeBrush="#14B8A6"
                                                MediumRangeBrush="#F59E0B"
                                                HighRangeBrush="#E11D48"
                                                NeedleBrush="{Binding TransitionNeedleBrush}"
                                                PivotBrush="#312E81">
                                <controls:DialGauge.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Value" Duration="0:0:0.65" />
                                        <BrushTransition Property="NeedleBrush" Duration="0:0:0.45" />
                                    </Transitions>
                                </controls:DialGauge.Transitions>
                            </controls:DialGauge>
                            <TextBlock HorizontalAlignment="Center" Text="Value + needle transition" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Command="{Binding ToggleTransitionValueCommand}"
                                    Content="Change value" />
                            <Button Command="{Binding ToggleTransitionNeedleCommand}"
                                    Content="Change needle" />
                        </StackPanel>
                    </Grid>
                </controls:AvioraCard>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
