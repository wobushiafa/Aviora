<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Aviora.Controls"
             xmlns:vm="using:Aviora.Demo.ViewModels"
             x:Class="Aviora.Demo.Views.BackdropBlurPage"
             x:DataType="vm:BackdropBlurPageViewModel"
             mc:Ignorable="d"
             d:DesignWidth="780"
             d:DesignHeight="620">
    <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="BackdropBlur" />
            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                       Text="Blur the background beneath a tinted, rounded surface." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,4,4,24" Spacing="18">
                <controls:AvioraCard HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Backdrop preview" />
                            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                       Text="Compare the sharp background outside the panel with the blurred area inside." />
                        </StackPanel>
                        <Border CornerRadius="16" ClipToBounds="True">
                            <Grid Height="300">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#312E81" Offset="0" />
                                        <GradientStop Color="#0369A1" Offset="0.5" />
                                        <GradientStop Color="#0F766E" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Ellipse Width="190" Height="190" Fill="#FBBF24"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,-40,0,0" />
                                <Ellipse Width="230" Height="230" Fill="#F472B6"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-35,-70" />
                                <StackPanel VerticalAlignment="Center" Spacing="24">
                                    <TextBlock FontSize="44" FontWeight="Bold" Foreground="#80FFFFFF"
                                               HorizontalAlignment="Center" Text="AVIORA / GLASS" />
                                    <Border Height="6" Background="#99FFFFFF" Margin="24,0" />
                                    <TextBlock FontSize="20" Foreground="White"
                                               HorizontalAlignment="Center" Text="Color · Shape · Texture" />
                                </StackPanel>
                                <!-- The surface and foreground are siblings: BackdropBlur is not a content control. -->
                                <Grid Margin="36" MaxWidth="420" HorizontalAlignment="Stretch">
                                    <controls:BackdropBlur Background="#B3FFFFFF" BorderBrush="#CCFFFFFF"
                                                           BorderThickness="1" CornerRadius="{Binding PreviewCornerRadius}"
                                                           BlurRadius="{Binding #BlurRadiusInput.Value}"
                                                           RenderScale="{Binding RenderScale}"
                                                           IsHitTestVisible="False" />
                                    <StackPanel Margin="24" VerticalAlignment="Center" Spacing="10">
                                        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F172A"
                                                   Text="A softer view" />
                                        <TextBlock Foreground="#1E293B" TextWrapping="Wrap"
                                                   Text="The colors and details behind this panel are blurred while its foreground stays sharp." />
                                        <Button HorizontalAlignment="Left" Content="Foreground button" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" Text="Corner radius" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="80" Value="{Binding CornerRadius}"
                                    AutomationProperties.Name="Corner radius" />
                            <TextBlock Grid.Column="2" MinWidth="24" VerticalAlignment="Center"
                                       Text="{Binding CornerRadius, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" Text="Blur radius" />
                            <Slider Grid.Column="1" x:Name="BlurRadiusInput" Minimum="0" Maximum="32" Value="12"
                                    AutomationProperties.Name="Blur radius" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" Text="Sampling scale" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RenderScales}" SelectedItem="{Binding RenderScale}"
                                      AutomationProperties.Name="Background sampling scale" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap"
                                       Text="1 = full detail · 0.75 / 0.5 = lower sampling resolution. Corners and foreground stay sharp." />
                        </Grid>
                    </StackPanel>
                </controls:AvioraCard>

                <controls:AvioraCard HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Surface tints" />
                        <Border CornerRadius="12" ClipToBounds="True">
                            <Grid Height="180" Background="#2563EB">
                                <Ellipse Width="220" Height="220" Fill="#FB923C" HorizontalAlignment="Center" />
                                <Border Height="12" Background="#FDE68A" VerticalAlignment="Center" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="20">
                                    <controls:BackdropBlur Background="#B3FFFFFF" BorderBrush="#CCFFFFFF"
                                                           BorderThickness="1" CornerRadius="16" />
                                    <TextBlock Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="#0F172A" FontWeight="SemiBold" Text="Light tint" />
                                    <controls:BackdropBlur Grid.Column="1" Background="#B30F172A" BorderBrush="#66FFFFFF"
                                                           BorderThickness="1" CornerRadius="16" />
                                    <TextBlock Grid.Column="1" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="White" FontWeight="SemiBold" Text="Dark tint" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </controls:AvioraCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
