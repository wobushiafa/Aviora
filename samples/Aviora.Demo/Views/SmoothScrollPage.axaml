<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:aviora="https://github.com/wobushiafa/Aviora"
             xmlns:vm="using:Aviora.Demo.ViewModels"
             x:Class="Aviora.Demo.Views.SmoothScrollPage"
             x:DataType="vm:SmoothScrollPageViewModel"
             mc:Ignorable="d"
             d:DesignWidth="820"
             d:DesignHeight="680">
    <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="SmoothScrollAssist" />
            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                       Text="Attached properties for customizable, frame-rate-independent wheel scrolling on any ScrollViewer or composite ItemsControl." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      aviora:SmoothScrollAssist.IsEnabled="{Binding IsSmoothEnabled}"
                      aviora:SmoothScrollAssist.Preset="{Binding SelectedPreset}">
            <StackPanel Margin="4,4,4,24" Spacing="18">
                <aviora:AvioraCard HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Physics &amp; curve playground" />
                                <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                           Text="Tune step size, damping, easing duration, and queue limits, then compare left vs. right." />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{Binding ResetPresetCommand}"
                                    Content="Reset preset" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal">
                            <CheckBox Margin="0,0,18,8"
                                      Content="Enable smooth scroll"
                                      IsChecked="{Binding IsSmoothEnabled}" />
                            <CheckBox Margin="0,0,18,8"
                                      Content="Shift + Wheel horizontal"
                                      IsChecked="{Binding IsShiftWheelHorizontalEnabled}" />
                            <StackPanel Margin="0,0,18,8" Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Preset" />
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8" Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Curve" />
                                <ComboBox ItemsSource="{Binding CurveModes}" SelectedItem="{Binding SelectedCurveMode}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Orientation" />
                                <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}" />
                            </StackPanel>
                        </WrapPanel>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" Text="Step size (DIPs)" />
                            <Slider Grid.Column="1" Minimum="32" Maximum="240" Value="{Binding StepSize}" />
                            <TextBlock Grid.Column="2" MinWidth="44" VerticalAlignment="Center"
                                       Text="{Binding StepSize, StringFormat={}{0:0}}" />
                        </Grid>

                        <StackPanel IsVisible="{Binding IsExponentialMode}" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Initial step factor" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="0.6" Value="{Binding InitialStepFactor}" />
                                <TextBlock Grid.Column="2" MinWidth="44" VerticalAlignment="Center"
                                           Text="{Binding InitialStepFactor, StringFormat={}{0:0.00}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Decay rate" />
                                <Slider Grid.Column="1" Minimum="6" Maximum="36" Value="{Binding DecayRate}" />
                                <TextBlock Grid.Column="2" MinWidth="44" VerticalAlignment="Center"
                                           Text="{Binding DecayRate, StringFormat={}{0:0.0}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Min speed (DIP/s)" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="160" Value="{Binding MinSpeed}" />
                                <TextBlock Grid.Column="2" MinWidth="44" VerticalAlignment="Center"
                                           Text="{Binding MinSpeed, StringFormat={}{0:0}}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsEasingMode}" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Duration (ms)" />
                                <Slider Grid.Column="1" Minimum="60" Maximum="600" Value="{Binding DurationMs}" />
                                <TextBlock Grid.Column="2" MinWidth="44" VerticalAlignment="Center"
                                           Text="{Binding DurationMs, StringFormat={}{0:0}}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Easing function" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding EasingOptions}"
                                          SelectedItem="{Binding SelectedEasingOption}" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" Text="Max queue distance" />
                            <Slider Grid.Column="1" Minimum="120" Maximum="1200" Value="{Binding MaxQueueDistance}" />
                            <TextBlock Grid.Column="2" MinWidth="44" VerticalAlignment="Center"
                                       Text="{Binding MaxQueueDistance, StringFormat={}{0:0}}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center" Text="Trackpad threshold" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1.0" Value="{Binding TrackpadThreshold}" />
                            <TextBlock Grid.Column="2" MinWidth="44" VerticalAlignment="Center"
                                       Text="{Binding TrackpadThreshold, StringFormat={}{0:0.00}}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="With SmoothScrollAssist" />
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer Height="260"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  aviora:SmoothScrollAssist.IsEnabled="{Binding IsSmoothEnabled}"
                                                  aviora:SmoothScrollAssist.Preset="{Binding SelectedPreset}"
                                                  aviora:SmoothScrollAssist.CurveMode="{Binding SelectedCurveMode}"
                                                  aviora:SmoothScrollAssist.Orientation="{Binding SelectedOrientation}"
                                                  aviora:SmoothScrollAssist.StepSize="{Binding StepSize}"
                                                  aviora:SmoothScrollAssist.InitialStepFactor="{Binding InitialStepFactor}"
                                                  aviora:SmoothScrollAssist.DecayRate="{Binding DecayRate}"
                                                  aviora:SmoothScrollAssist.MinSpeed="{Binding MinSpeed}"
                                                  aviora:SmoothScrollAssist.Duration="{Binding Duration}"
                                                  aviora:SmoothScrollAssist.Easing="{Binding ActiveEasing}"
                                                  aviora:SmoothScrollAssist.MaxQueueDistance="{Binding MaxQueueDistance}"
                                                  aviora:SmoothScrollAssist.TrackpadThreshold="{Binding TrackpadThreshold}"
                                                  aviora:SmoothScrollAssist.IsShiftWheelHorizontalEnabled="{Binding IsShiftWheelHorizontalEnabled}">
                                        <ItemsControl ItemsSource="{Binding SampleRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SmoothScrollRowItem">
                                                    <Border Margin="8,4"
                                                            Padding="12,10"
                                                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                            CornerRadius="6">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Border Width="8"
                                                                    CornerRadius="4"
                                                                    Background="{Binding BadgeHex}" />
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                                <TextBlock FontSize="12" Opacity="0.65" Text="{Binding Subtitle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Native ScrollViewer (baseline)" />
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer Height="260" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding SampleRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SmoothScrollRowItem">
                                                    <Border Margin="8,4"
                                                            Padding="12,10"
                                                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                            CornerRadius="6">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Border Width="8"
                                                                    CornerRadius="4"
                                                                    Background="{Binding BadgeHex}" />
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                                <TextBlock FontSize="12" Opacity="0.65" Text="{Binding Subtitle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </aviora:AvioraCard>

                <aviora:AvioraCard HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Horizontal gallery" />
                                <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                           Text="Automatically maps vertical wheel ticks to horizontal smooth scrolling when vertical scroll is disabled." />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Content="Auto horizontal"
                                      IsChecked="{Binding AutoHorizontalOnGallery}" />
                        </Grid>

                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          aviora:SmoothScrollAssist.IsEnabled="{Binding IsSmoothEnabled}"
                                          aviora:SmoothScrollAssist.Preset="{Binding SelectedPreset}"
                                          aviora:SmoothScrollAssist.CurveMode="{Binding SelectedCurveMode}"
                                          aviora:SmoothScrollAssist.StepSize="{Binding StepSize}"
                                          aviora:SmoothScrollAssist.InitialStepFactor="{Binding InitialStepFactor}"
                                          aviora:SmoothScrollAssist.DecayRate="{Binding DecayRate}"
                                          aviora:SmoothScrollAssist.MinSpeed="{Binding MinSpeed}"
                                          aviora:SmoothScrollAssist.Duration="{Binding Duration}"
                                          aviora:SmoothScrollAssist.Easing="{Binding ActiveEasing}"
                                          aviora:SmoothScrollAssist.IsShiftWheelHorizontalEnabled="{Binding IsShiftWheelHorizontalEnabled}"
                                          aviora:SmoothScrollAssist.AutoHorizontalWhenVerticalDisabled="{Binding AutoHorizontalOnGallery}">
                                <ItemsControl ItemsSource="{Binding GalleryItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Margin="10" Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SmoothScrollGalleryItem">
                                            <Border Width="190"
                                                    Height="116"
                                                    Padding="14"
                                                    Background="{Binding AccentHex}"
                                                    CornerRadius="10">
                                                <StackPanel VerticalAlignment="Center" Spacing="6">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#CCFFFFFF"
                                                               Text="{Binding Tag}" />
                                                    <TextBlock FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               Text="{Binding Title}" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="#E6FFFFFF"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Detail}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </aviora:AvioraCard>

                <aviora:AvioraCard HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Universal host (ListBox)" />
                            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                       Text="Attached directly on a ListBox without editing its control template; inherits the selected preset." />
                        </StackPanel>

                        <ListBox Height="220"
                                 ItemsSource="{Binding SampleRows}"
                                 aviora:SmoothScrollAssist.IsEnabled="{Binding IsSmoothEnabled}"
                                 aviora:SmoothScrollAssist.Preset="{Binding SelectedPreset}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SmoothScrollRowItem">
                                    <StackPanel Margin="4,2" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock FontSize="12" Opacity="0.65" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </aviora:AvioraCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
